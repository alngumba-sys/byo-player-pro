# Secrets for the BYO-payments Edge Functions.
# Set them with:  supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically at runtime.)

# Shared secret the Android collector phone must send in the x-api-key header.
# Generate a long random string:  openssl rand -hex 32
COLLECTOR_API_KEY=replace-with-openssl-rand-hex-32

# Shared secret the admin dashboard sends in x-api-key.
ADMIN_API_KEY=replace-with-another-openssl-rand-hex-32

# The single telebirr number everyone pays to (test: the SIM on the collector phone).
TELEBIRR_COLLECTION_NUMBER=0913028610

# ---- M-Pesa (Kenya, Safaricom Daraja STK push) ----
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://lkftnbkuuitaxtlvrqfj.supabase.co/functions/v1/payment-webhook?provider=daraja

# ---- Cards (choose one provider, then implement createCheckout in card-checkout) ----
CARD_PROVIDER=
FLW_SECRET_KEY=
CARD_REDIRECT_URL=https://byoplayer.com/paid
